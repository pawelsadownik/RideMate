{
  "expo": {
    "name": "RideMate",
    "slug": "ridemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "appcity.ridemate",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideMate potrzebuje lokalizacji, aby pokazać osoby w pobliżu.",
        "NSCameraUsageDescription": "RideMate potrzebuje dostępu do kamery, aby dodać zdjęcie profilowe.",
        "NSPhotoLibraryUsageDescription": "RideMate potrzebuje dostępu do galerii, aby wgrać zdjęcia profilowe."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "appcity.ridemate",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF5E50",
          "defaultChannel": "ridemate"
        }
      ],
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {},
    "scheme": "ridemate"
  }
}
